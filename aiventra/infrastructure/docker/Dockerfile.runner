FROM python:3.12-slim
WORKDIR /broker
COPY pyproject.toml uv.lock ./
COPY apps/api ./apps/api
RUN pip install --no-cache-dir uv==0.12.3 && uv sync --locked --no-dev
ENV PATH="/broker/.venv/bin:$PATH"
EXPOSE 8090
CMD ["uvicorn", "company_os.runner_service:app", "--host", "0.0.0.0", "--port", "8090", "--no-access-log"]
