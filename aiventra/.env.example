# Generate your local .env with scripts/bootstrap.ps1. Never commit it.
APP_ENV=development
# Harness-only: never enable fixture visibility in the owner workspace.
ISOLATED_TEST_ENVIRONMENT=false
ISOLATED_POSTGRES_CI=false
FIXTURE_CATALOG_ENABLED=false
AI_SPENDING_MODE=ZERO_COST_ONLY
DATABASE_URL=sqlite:///./data/company.db
REQUIRED_DATABASE_BACKEND=sqlite
DELIVERY_RELEASE_TTL_SECONDS=3600
CLIENT_INVITATION_TTL_SECONDS=172800
JWT_SECRET=replace-with-at-least-32-random-characters
PROVIDER_SECRET_KEY=replace-with-base64-encoded-32-byte-key
OWNER_EMAIL=owner@local.test
OWNER_PASSWORD=replace-with-a-long-unique-password
DB_PASSWORD=replace-with-a-database-password
WEB_ORIGIN=http://localhost:3000
COOKIE_SECURE=false
MOCK_ENABLED=true
EXECUTION_ENABLED=false
RUNNER_URL=http://127.0.0.1:8090
RUNNER_TOKEN=replace-with-an-independent-runner-token
# Generated PR connector is disabled until a scoped token and repository allowlist are configured.
GITHUB_PUBLICATION_TOKEN_ENV=AIVENTRA_GITHUB_TOKEN
GITHUB_PUBLICATION_REPOSITORIES=
AIVENTRA_GITHUB_TOKEN=
# CPU-local embedding cache is prepared explicitly, never downloaded during startup.
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_CACHE=./data/embeddings
EMBEDDING_ENDPOINT=http://127.0.0.1:11434
SCHEDULER_CONCURRENCY=4
# Local inference is admitted one at a time; these limits do not download models.
OLLAMA_CONTEXT_TOKENS=8192
OLLAMA_THINKING=false
# Optional admission floor; unknown or lower available RAM blocks before inference.
OLLAMA_MIN_AVAILABLE_MEMORY_MB=1536
OLLAMA_KEEP_ALIVE_SECONDS=0
OLLAMA_READ_TIMEOUT_SECONDS=120
OLLAMA_REQUEST_TIMEOUT_SECONDS=180
LOGIN_WINDOW_SECONDS=60
LOGIN_ACCOUNT_LIMIT=10
LOGIN_SOURCE_LIMIT=100
WORKER_STALE_SECONDS=90
ARTIFACT_ROOT=./artifacts
REPOSITORY_ROOT=./data/repositories
PROVIDER_ALLOWED_HOSTS=api.openai.com,api.anthropic.com,generativelanguage.googleapis.com,api.x.ai,api.deepseek.com,localhost,127.0.0.1
RESEARCH_ALLOWED_HOSTS=cloud.google.com,lightning.ai,aws.amazon.com,azure.microsoft.com
# Environment credentials are optional fallbacks for the encrypted provider vault.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=
# Production OIDC bearer validation; browser OIDC login is a future milestone.
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URL=
# Optional object storage. Keep buckets private.
S3_BUCKET=
S3_ENDPOINT=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
